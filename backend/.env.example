# ============================================================
# EDUFLEX PRO — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs
# ============================================================

# NODE
NODE_ENV=development
PORT=3000

# MICROSERVICES TCP PORTS
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=3001
USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=3002
COURSE_SERVICE_HOST=localhost
COURSE_SERVICE_PORT=3003
MEDIA_SERVICE_HOST=localhost
MEDIA_SERVICE_PORT=3004
PAYMENT_SERVICE_HOST=localhost
PAYMENT_SERVICE_PORT=3005
NOTIFICATION_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_PORT=3006
SEARCH_SERVICE_HOST=localhost
SEARCH_SERVICE_PORT=3007
ANALYTICS_SERVICE_HOST=localhost
ANALYTICS_SERVICE_PORT=3008
CERTIFICATE_SERVICE_HOST=localhost
CERTIFICATE_SERVICE_PORT=3009

# POSTGRESQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=eduflex_user
DB_PASSWORD=eduflex_secure_password_2024
DB_DATABASE=eduflex_pro
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MAX_CONNECTIONS=100

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_DB=0
REDIS_TTL=3600

# JWT
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d
JWT_ISSUER=eduflex-pro
JWT_AUDIENCE=eduflex-users

# OAUTH — GOOGLE
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.eduflex.com/v1/auth/google/callback

# OAUTH — FACEBOOK
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://api.eduflex.com/v1/auth/facebook/callback

# STRIPE
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_COMMISSION_RATE=0.20

# NOTCHPAY (Paiement Afrique / Mobile Money)
NOTCHPAY_PUBLIC_KEY=pk.your_notchpay_public_key
NOTCHPAY_PRIVATE_KEY=sk.your_notchpay_private_key
NOTCHPAY_HASH=your_notchpay_hash
NOTCHPAY_BASE_URL=https://api.notchpay.co

# AWS S3 / CLOUDFLARE R2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=eduflex-pro-media
AWS_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
CDN_BASE_URL=https://cdn.eduflex.com

# CLOUDFLARE STREAM (Vidéo)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_STREAM_API_TOKEN=your_cloudflare_stream_api_token
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=your_customer_subdomain

# RESEND (Emails)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=no-reply@eduflex.com
RESEND_FROM_NAME=EduFlex Pro

# FIREBASE (Push Notifications)
FIREBASE_PROJECT_ID=eduflex-pro
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@eduflex-pro.iam.gserviceaccount.com

# ELASTICSEARCH
ELASTICSEARCH_NODE=https://your-cluster.es.cloud.es.io
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password
ELASTICSEARCH_INDEX_PREFIX=eduflex_

# CRYPTOGRAPHIE
ENCRYPTION_KEY=your_32_char_encryption_key_here
BCRYPT_ROUNDS=12

# PAIEMENT — CONFIGURATION BUSINESS
INSTRUCTOR_STANDARD_COMMISSION=0.70
INSTRUCTOR_PREMIUM_COMMISSION=0.80
MINIMUM_PAYOUT_AMOUNT=50
REFUND_WINDOW_DAYS=30

# LIMITES & SÉCURITÉ
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE_MB=500
MAX_VIDEO_SIZE_GB=5

# FRONTEND URL (CORS)
FRONTEND_URL=https://eduflex.com
ADMIN_FRONTEND_URL=https://admin.eduflex.com

# LOGS
LOG_LEVEL=info
LOG_FILE=logs/eduflex.log

# BULL (Queue)
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=redis_secure_password

# APPLICATION
APP_URL=https://api.eduflex.com
PLATFORM_NAME=EduFlex Pro
SUPPORT_EMAIL=support@eduflex.com

